{
  "schema": 1,
  "contract": "profiles_v1",
  "batch": "HM-01: the MCP listener (8081) of the default profile, column ha",
  "baseline": "bb48449",
  "conditions": "Each product (packaging/inputs.json) with a configured backend, its child up and its readiness check passed; the production runtime on its real uvicorn listener (h11: %XX decoded once, no dot-segment removal, # kept); every target sent byte for byte with Content-Length and Connection: close; a POST body is the named JSON-RPC message.",
  "columns": {
    "ha": "bb48449, the default profile: response (key of responses), child (the child got the request) and profile (who served it)",
    "ha_products": "per-product exceptions to ha",
    "paas_observed": "PaaS status in the 2026-11-13 Odoo profile-isolation run (T-05, receipt s04-token-routing.json); comparison only, never asserted",
    "deviation": "the row of the deliberate-difference table (multi-profile plan 8.8; docs/multi-profile/contract.md from HM-00) behind an HA answer that differs from PaaS"
  },
  "placeholders": {
    "A": "the default profile's token",
    "B": "another well-formed token: no profile has it in HM-01 (B's own path is then an unknown token), an extra profile's from HM-08",
    "AU": "A in upper case",
    "AP1": "A with its first character percent-encoded",
    "APA": "A with every character percent-encoded",
    "AT": "A without its last character",
    "R43": "a random 43-character URL-safe token",
    "R64": "64 random hex digits",
    "R257": "257 times 'a'",
    "P24": "24 random lowercase hex digits: the form of an extra profile's id (multi-profile plan 4.2); no profile has it in HM-01"
  },
  "bodies": {
    "initialize": "initialize, id 1, protocolVersion 2025-06-18",
    "tools_list": "tools/list, id 2",
    "initialized": "notifications/initialized",
    "discover": "server/discover, id 9",
    "malformed": "the single byte {",
    "none": "no body"
  },
  "responses": {
    "initialize": {
      "meaning": "the child answered; the body is the gateway's own initialize result for the product (tests/test_single_profile_golden.py initialize_body)",
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "cache-control": "no-store"
      },
      "body": "<initialize>"
    },
    "not_found": {
      "meaning": "Starlette's unknown-path answer; a wrong, revoked or unset secret-path token gets the same bytes (gateway.serve)",
      "status": 404,
      "headers": {
        "content-type": "text/plain; charset=utf-8",
        "content-length": "9"
      },
      "absent": [
        "www-authenticate",
        "cache-control"
      ],
      "body": "Not Found"
    },
    "bearer_required": {
      "meaning": "missing or wrong Bearer token on /mcp (gateway.serve unauthorized)",
      "status": 401,
      "headers": {
        "www-authenticate": "Bearer",
        "content-length": "0"
      },
      "absent": [
        "content-type"
      ],
      "body": ""
    },
    "denied_400": {
      "meaning": "BadRequest(400): a query string, a malformed body",
      "status": 400,
      "headers": {
        "content-type": "application/json"
      },
      "absent": [
        "www-authenticate"
      ],
      "body": "{\"error\":\"request denied\"}"
    },
    "denied_403": {
      "meaning": "BadRequest(403): an Origin the path does not allow",
      "status": 403,
      "headers": {
        "content-type": "application/json"
      },
      "absent": [
        "www-authenticate"
      ],
      "body": "{\"error\":\"request denied\"}"
    },
    "unsupported_415": {
      "meaning": "BadRequest(415): a body that is not application/json",
      "status": 415,
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"error\":\"request denied\"}"
    },
    "method_not_allowed": {
      "meaning": "any method but GET, POST and DELETE, after the token check",
      "status": 405,
      "headers": {
        "allow": "GET, POST, DELETE",
        "content-length": "0"
      },
      "body": ""
    },
    "session_required_id_2": {
      "meaning": "a request other than initialize without Mcp-Session-Id (child_status_reply 400)",
      "status": 400,
      "headers": {
        "content-type": "application/json",
        "cache-control": "no-store"
      },
      "body": "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32000,\"message\":\"Bad Request\"}}"
    },
    "session_required_id_null": {
      "meaning": "a GET stream without Mcp-Session-Id",
      "status": 400,
      "headers": {
        "content-type": "application/json",
        "cache-control": "no-store"
      },
      "body": "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32000,\"message\":\"Bad Request\"}}"
    },
    "session_required_bare": {
      "meaning": "a DELETE or a notification without Mcp-Session-Id",
      "status": 400,
      "headers": {
        "cache-control": "no-store",
        "content-length": "0"
      },
      "absent": [
        "content-type"
      ],
      "body": ""
    },
    "method_not_found_id_9": {
      "meaning": "an unknown JSON-RPC request (server/discover), answered by the gateway",
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "cache-control": "no-store"
      },
      "body": "{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}"
    },
    "parse_error_n8n": {
      "meaning": "n8n's bounded body reader (request_limits): invalid JSON is a JSON-RPC parse error",
      "status": 400,
      "headers": {
        "content-type": "application/json",
        "cache-control": "no-store"
      },
      "body": "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"Invalid or excessively nested JSON\"}}"
    },
    "ready": {
      "meaning": "GET /health/ready with a configured, reachable backend",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"ready\":true}"
    }
  },
  "cases": [
    {"id": "connect-bearer", "group": "connect", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"]], "body": "initialize", "ha": {"response": "initialize", "child": true, "profile": "default"}},
    {"id": "connect-secret", "group": "connect", "method": "POST", "target": "/private_{A}/mcp", "headers": [], "body": "initialize", "ha": {"response": "initialize", "child": true, "profile": "default"}},
    {"id": "error-bearer-missing", "group": "error", "method": "POST", "target": "/mcp", "headers": [], "body": "initialize", "ha": {"response": "bearer_required", "child": false, "profile": null}},
    {"id": "error-bearer-wrong-token", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {R43}"]], "body": "initialize", "deviation": "§8.8 #1", "ha": {"response": "bearer_required", "child": false, "profile": null}},
    {"id": "error-bearer-scheme-lowercase", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "bearer {A}"]], "body": "initialize", "note": "exactly \"Bearer \" + token (gateway.token_valid)", "ha": {"response": "bearer_required", "child": false, "profile": null}},
    {"id": "error-bearer-double-space", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer  {A}"]], "body": "initialize", "ha": {"response": "bearer_required", "child": false, "profile": null}},
    {"id": "error-bearer-two-headers", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"], ["Authorization", "Bearer {A}"]], "body": "initialize", "note": "exactly one Authorization header", "ha": {"response": "bearer_required", "child": false, "profile": null}},
    {"id": "error-bearer-origin", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"], ["Origin", "https://claude.ai"]], "body": "initialize", "note": "browsers are not in the Bearer contract; checked after the token", "deviation": "§8.8 #10", "ha": {"response": "denied_403", "child": false, "profile": null}},
    {"id": "error-bearer-query", "group": "error", "method": "POST", "target": "/mcp?x=1", "headers": [["Authorization", "Bearer {A}"]], "body": "initialize", "note": "any query string, after the token check", "deviation": "§8.8 #3", "ha": {"response": "denied_400", "child": false, "profile": null}},
    {"id": "error-bearer-put", "group": "error", "method": "PUT", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"]], "body": "none", "note": "the method rule only after the token check", "ha": {"response": "method_not_allowed", "child": false, "profile": null}},
    {"id": "error-bearer-put-wrong-token", "group": "error", "method": "PUT", "target": "/mcp", "headers": [["Authorization", "Bearer {R43}"]], "body": "none", "ha": {"response": "bearer_required", "child": false, "profile": null}},
    {"id": "error-bearer-trailing-slash", "group": "error", "method": "POST", "target": "/mcp/", "headers": [["Authorization", "Bearer {A}"]], "body": "initialize", "note": "no slash redirect (redirect_slashes off)", "deviation": "§8.8 #3", "ha": {"response": "not_found", "child": false, "profile": null}},
    {"id": "error-bearer-get-without-session", "group": "error", "method": "GET", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"]], "body": "none", "ha": {"response": "session_required_id_null", "child": false, "profile": null}},
    {"id": "error-bearer-delete-without-session", "group": "error", "method": "DELETE", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"]], "body": "none", "ha": {"response": "session_required_bare", "child": false, "profile": null}},
    {"id": "error-bearer-request-without-session", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"]], "body": "tools_list", "note": "anything but initialize needs the session it opened", "ha": {"response": "session_required_id_2", "child": false, "profile": null}},
    {"id": "error-bearer-notification-without-session", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"]], "body": "initialized", "ha": {"response": "session_required_bare", "child": false, "profile": null}},
    {"id": "error-bearer-unknown-method", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"]], "body": "discover", "note": "answered before the session check, a slot or the child", "ha": {"response": "method_not_found_id_9", "child": false, "profile": null}},
    {"id": "error-bearer-malformed-json", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"]], "body": "malformed", "ha": {"response": "denied_400", "child": false, "profile": null}, "ha_products": {"n8n": {"response": "parse_error_n8n", "child": false, "profile": null}}},
    {"id": "error-bearer-wrong-content-type", "group": "error", "method": "POST", "target": "/mcp", "headers": [["Authorization", "Bearer {A}"], ["Content-Type", "text/plain"]], "body": "initialize", "ha": {"response": "unsupported_415", "child": false, "profile": null}},
    {"id": "error-secret-wrong-token", "group": "error", "method": "POST", "target": "/private_{R43}/mcp", "headers": [], "body": "initialize", "note": "the same bytes as an unknown path", "deviation": "§8.8 #1", "ha": {"response": "not_found", "child": false, "profile": null}},
    {"id": "error-secret-query", "group": "error", "method": "POST", "target": "/private_{A}/mcp?x=1", "headers": [], "body": "initialize", "deviation": "§8.8 #3", "ha": {"response": "denied_400", "child": false, "profile": null}},
    {"id": "error-secret-put", "group": "error", "method": "PUT", "target": "/private_{A}/mcp", "headers": [], "body": "none", "ha": {"response": "method_not_allowed", "child": false, "profile": null}},
    {"id": "error-secret-put-wrong-token", "group": "error", "method": "PUT", "target": "/private_{R43}/mcp", "headers": [], "body": "none", "note": "a wrong token never learns the method rule", "deviation": "§8.8 #1", "ha": {"response": "not_found", "child": false, "profile": null}},
    {"id": "error-secret-origin-claude", "group": "error", "method": "POST", "target": "/private_{A}/mcp", "headers": [["Origin", "https://claude.ai"]], "body": "initialize", "ha": {"response": "initialize", "child": true, "profile": "default"}},
    {"id": "error-secret-origin-other", "group": "error", "method": "POST", "target": "/private_{A}/mcp", "headers": [["Origin", "https://untrusted.invalid"]], "body": "initialize", "note": "any Origin on the secret path, except Headscale (only https://claude.ai)", "deviation": "§8.8 #9", "ha": {"response": "initialize", "child": true, "profile": "default"}, "ha_products": {"headscale": {"response": "denied_403", "child": false, "profile": null}}},
