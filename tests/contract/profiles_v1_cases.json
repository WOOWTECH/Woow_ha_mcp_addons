    {"id": "switch-query-profile-b", "group": "header_switch", "paas_name": "query_profile=B", "paas_observed": 200, "method": "POST", "target": "/private_{A}/mcp?profile={P24}", "headers": [], "body": "initialize", "note": "HA refuses any query string (PaaS ignores it)", "deviation": "§8.8 #3", "ha": {"response": "denied_400", "child": false, "profile": null}},
