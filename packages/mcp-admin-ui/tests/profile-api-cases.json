        {"name": "rename-blank-label", "request": {"method": "PATCH", "path": "/api/profiles/{N}", "csrf": true, "if_match": "index", "body": {"label": "  "}}, "keys": "*", "expect": {"status": 422, "etag": null, "body": {"error": "request denied", "detail": {"code": "profile_label_invalid"}}}},
