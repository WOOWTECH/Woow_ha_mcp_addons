    {
      "name": "rows",
      "about": "the list's rows for a profile its state cannot be read (U: indexed, its directory gone) and one over the memory limit (C)",
      "setup": {"product": "odoo", "memory_limit_mib": 512, "extras": [{"role": "B", "label": "Beta Ops", "status": "running"}, {"role": "C", "label": "Gamma Ops", "status": "blocked", "disabled_reason": "memory_capacity", "blocked_reason": "memory_capacity", "required_memory_mib": 556}], "unavailable": [{"role": "U", "label": "Upsilon Ops"}]},
      "cases": [
