        {"name": "delete-orphan", "request": {"method": "DELETE", "path": "/api/profiles/{O}", "csrf": true, "if_match": "index", "key": "new"}, "keys": "*", "expect": {"status": 200, "etag": "p1", "body": {"deleted": "<O>", "operation": {"id": "<key:delete-orphan>", "kind": "profile.delete", "state": "completed", "replayed": false}}}},
        {"name": "quarantine-usable-index", "request": {"method": "POST", "path": "/api/profiles/index/quarantine", "csrf": true, "if_match": "index", "key": "new"}, "keys": "*", "expect": {"status": 409, "etag": "p1", "body": {"detail": {"code": "config_conflict"}}}},
        {"name": "list-after", "request": {"method": "GET", "path": "/api/profiles"}, "keys": "*", "expect": {"status": 200, "etag": "p1", "body": {"profiles": [{"id": "default", "label": "Default", "port": "<int>", "is_default": true, "disabled_reason": null, "status": "running", "blocked_reason": null}, {"id": "<B>", "label": "Beta Ops", "port": "<int>", "is_default": false, "disabled_reason": null, "status": "running", "blocked_reason": null}], "orphans": []}}}
      ]
