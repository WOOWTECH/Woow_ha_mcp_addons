        {"name": "delete-default", "request": {"method": "DELETE", "path": "/api/profiles/default", "csrf": true, "if_match": "index", "key": "new"}, "keys": "*", "expect": {"status": 422, "etag": null, "body": {"error": "request denied", "detail": {"code": "profile_default_immutable"}}}},
        {"name": "delete-unknown", "request": {"method": "DELETE", "path": "/api/profiles/{X}", "csrf": true, "if_match": "index", "key": "new"}, "keys": "*", "expect": {"status": 404, "etag": null, "body": {"error": "request denied", "detail": {"code": "profile_not_found"}}}},
