        {"name": "delete-gone-stale", "request": {"method": "DELETE", "path": "/api/profiles/{N}", "csrf": true, "if_match": "stale-index", "key": "new"}, "keys": "*", "expect": {"status": 409, "etag": "p1", "body": {"detail": {"code": "config_conflict"}}}},
