# Build from repository ROOT: docker build -f apps/n8n/Dockerfile .
FROM node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe AS ui
WORKDIR /ui
COPY packages/mcp-admin-ui/package.json packages/mcp-admin-ui/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY packages/mcp-admin-ui/src ./src
COPY packages/mcp-admin-ui/scripts/build.mjs ./scripts/build.mjs
COPY packages/mcp-admin-ui/NOTICE.txt ./NOTICE.txt
RUN npm run build
FROM astral/uv:0.12.10@sha256:34c0f9a55abeb840c34391bb7b63a1a06f8cb9281e028f27757a01a1a8a2d461 AS uv
FROM node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe AS npm
WORKDIR /npm
COPY apps/n8n/package.json apps/n8n/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund && npm cache clean --force
# Unreleased (0.4.12 line): the one native addon, better-sqlite3's prebuilt binary for Node 26 (ABI 147), so n8n-mcp opens its
# FTS5 database natively instead of falling back to sql.js (search_nodes ranked core nodes behind community ones). npm
# still installs nothing but the hash-locked tree and runs no script; this is the only other way a binary enters the
# image: the pinned release asset (inputs.json native_addons, checked against these literals by packaging/validate.py),
# verified by size and sha256 before it is opened, one tar entry of the pinned name, size and sha256, written as 0644 under
# the installed package of the pinned version. The build stops unless the addon then loads and runs FTS5 on this node.
COPY packaging/native_addon.mjs ./native_addon.mjs
RUN node native_addon.mjs install --version 12.11.1 --into node_modules/better-sqlite3 \
      --url https://github.com/WiseLibs/better-sqlite3/releases/download/v12.11.1/better-sqlite3-v12.11.1-node-v147-linux-x64.tar.gz \
      --sha256 a90711eae785b646d6799b31cf8dd79a5d750b1af72d310472c3b996c5cee92d --size 1114012 \
      --member build/Release/better_sqlite3.node --member-size 2162544 \
      --member-sha256 44170d6656cd1a6b67c88816db5820f8f3719417b634f5218182e306c63784f7 \
 && node -e "const db = require('./node_modules/better-sqlite3')(':memory:'); db.exec('create virtual table t using fts5(a)'); process.stdout.write('better-sqlite3 ' + db.prepare('select sqlite_version() v').get().v + ' fts5 ok on ' + process.version + '\n')" \
 && rm native_addon.mjs
FROM python:3.13.18-slim-bookworm@sha256:70bda1e795ded2a684ef9815955e05829b14ee5bb5c3eb2a940648e88f10fce9 AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
WORKDIR /opt/woow
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --python /usr/local/bin/python
FROM python:3.13.18-slim-bookworm@sha256:70bda1e795ded2a684ef9815955e05829b14ee5bb5c3eb2a940648e88f10fce9 AS runtime
# Generated by packaging/os_upgrades.py from inputs.json os_security_upgrades: exact-version
# upgrades from a fixed debian-security snapshot only (base sources unused). Remove when the base has them.
RUN mkdir /tmp/woow-apt-parts \
 && echo 'deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20261104T124343Z bookworm-security main' > /tmp/woow-security.list \
 && apt-get -o Dir::Etc::SourceList=/tmp/woow-security.list -o Dir::Etc::SourceParts=/tmp/woow-apt-parts update \
 && apt-get -o Dir::Etc::SourceList=/tmp/woow-security.list -o Dir::Etc::SourceParts=/tmp/woow-apt-parts install -y --no-install-recommends --only-upgrade apt=2.6.2 libapt-pkg6.0=2.6.2 libssl3=3.0.22-1~deb12u2 openssl=3.0.22-1~deb12u2 \
 && rm -rf /var/lib/apt/lists/* /tmp/woow-security.list /tmp/woow-apt-parts \
 && test "$(dpkg-query -W -f='${Version}' apt)" = "2.6.2" \
 && test "$(dpkg-query -W -f='${Version}' libapt-pkg6.0)" = "2.6.2" \
 && test "$(dpkg-query -W -f='${Version}' libssl3)" = "3.0.22-1~deb12u2" \
 && test "$(dpkg-query -W -f='${Version}' openssl)" = "3.0.22-1~deb12u2"
ARG BUILD_VERSION=0.4.13
LABEL io.hass.type="app" io.hass.arch="amd64" io.hass.version="${BUILD_VERSION}" \
      io.hass.name="Woow n8n MCP Server" io.hass.description="HA admin-role management; full tool surface; every tool and write on by default (each can be turned off in the panel)." \
      io.hass.url="https://github.com/WOOWTECH/Woow_ha_mcp_addons" \
      org.opencontainers.image.source="https://github.com/WOOWTECH/Woow_ha_mcp_addons" \
      org.opencontainers.image.version="${BUILD_VERSION}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/woow/packages/mcp-admin-core:/opt/woow/apps/n8n \
    PATH=/usr/local/bin:/usr/bin:/bin
WORKDIR /opt/woow
COPY --from=dependencies /opt/woow/.venv ./.venv
COPY packages/mcp-admin-core ./packages/mcp-admin-core
COPY --from=ui /ui/dist ./packages/mcp-admin-ui/dist
COPY apps/runtime ./apps/runtime
COPY apps/n8n ./apps/n8n
COPY --from=npm /usr/local/bin/node /usr/local/bin/node
COPY --from=npm /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /usr/local/lib/libstdc++.so.6
COPY --from=npm /lib/x86_64-linux-gnu/libgcc_s.so.1 /usr/local/lib/libgcc_s.so.1
# 0.4.0 (Node 26): the official node binary also links libatomic.so.1, which the python base lacks. The node stage has
# Debian bookworm's libatomic1 (12.2.0-14+deb12u1, source gcc-12 like the base's libgcc-s1); this image installs no
# packages (packaging/test_supply_chain.py), so the library is copied like the two above and node must start right here.
COPY --from=npm /usr/lib/x86_64-linux-gnu/libatomic.so.1 /usr/local/lib/libatomic.so.1
RUN /usr/sbin/ldconfig && test "$(node --version)" = v26.12.1
COPY --from=npm /npm/node_modules ./apps/n8n/node_modules
# Unreleased (0.4.12 line): the pinned native addon must also load with this stage's own libraries (libstdc++ and libgcc_s
# are copied above); a base or library change that breaks it stops the build here, not at the first search_nodes.
RUN node -e "const db = require('/opt/woow/apps/n8n/node_modules/better-sqlite3')(':memory:'); db.exec('create virtual table t using fts5(a)')"
# Compose backend-message preservation and native direct inputs compatibility through the same entrypoint as unit.sh.
# backend_policy.cjs requires the combined digest; the separate isError patch below remains applied.
RUN /usr/local/bin/python apps/n8n/patches/fix_test_run_error_messages.py
# 0.4.5: unsuccessful tool results set isError; guarded independently of handler patches.
RUN /usr/local/bin/python apps/n8n/patches/fix_tool_result_is_error.py
# 0.4.12: n8n_delete_workflow's description says a published workflow must be deactivated first (as the PaaS server).
RUN /usr/local/bin/python apps/n8n/patches/fix_delete_workflow_description.py
# n8n-mcp 2.96.2 emits object-valued validate_workflow warning/error details.
RUN /usr/local/bin/python apps/n8n/patches/fix_workflow_output_schema.py \
 && node --check apps/n8n/node_modules/n8n-mcp/dist/mcp/tools.js
COPY packaging/entrypoint.py packaging/management_launcher.py ./packaging/
COPY THIRD_PARTY_NOTICES.md ./THIRD_PARTY_NOTICES.md
COPY docs/provenance ./docs/provenance
RUN /usr/sbin/groupadd --gid 10001 mcp && /usr/sbin/useradd --uid 10001 --gid 10001 --no-create-home --home-dir /data/mcp --shell /usr/sbin/nologin mcp
# Root ONLY for no-follow creation/ownership of a NEW /data/mcp, then irreversible uid/gid drop.
# Supervisor-owned options are never chowned; an existing tree only in the verified HA-restore
# repair (packaging/entrypoint.py). No backend-dependent watchdog.
EXPOSE 8081
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/python", "/opt/woow/packaging/entrypoint.py", "n8n"]
