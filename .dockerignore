# Allowlisted ROOT context. Production Dockerfiles copy only core + selected app.
**
!pyproject.toml
!uv.lock
!packages/
!packages/mcp-admin-core/
!packages/mcp-admin-core/mcp_admin_core/
!packages/mcp-admin-core/mcp_admin_core/*.py
!packages/mcp-admin-ui/
!packages/mcp-admin-ui/package.json
!packages/mcp-admin-ui/package-lock.json
!packages/mcp-admin-ui/NOTICE.txt
!packages/mcp-admin-ui/src/
!packages/mcp-admin-ui/src/*.js
!packages/mcp-admin-ui/src/*.css
!packages/mcp-admin-ui/src/*.html
!packages/mcp-admin-ui/scripts/
!packages/mcp-admin-ui/scripts/build.mjs
!apps/
!apps/**/
!apps/**/*.py
!apps/*/pyproject.toml
!apps/*/uv.lock
!apps/*/Dockerfile
!apps/*/vendor/LICENSE
!apps/n8n/package.json
!apps/n8n/package-lock.json
!apps/n8n/backend_policy.cjs
!packaging/
!packaging/entrypoint.py
!packaging/management_launcher.py
!docs/
!docs/provenance/
!docs/provenance/*.md
!docs/provenance/*.json
!docs/provenance/*-LICENSE
!THIRD_PARTY_NOTICES.md
# Defense in depth: never include generated/deployed state, even below an allowlist.
**/.git
**/.venv
**/node_modules
**/__pycache__
**/.env*
**/.mcp.json
**/state.json
**/options.json
**/config.json
**/credentials*
**/*.pem
**/*.key
**/*.p12
**/*.log
**/backups
**/data
